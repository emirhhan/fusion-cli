{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Ana pencere ve konuşma penceresi yetkileri. opener:default yalnız URL açar ve dosyayı klasörde gösterir; plan dosyasını editörde açmak için open_path izni Fusion yapılandırma kökü (plans/) kapsamıyla ayrıca verilir.",
  "windows": [
    "main",
    "ses"
  ],
  "permissions": [
    "core:default",
    "updater:default",
    "process:allow-restart",
    "core:window:allow-start-dragging",
    "core:window:allow-set-background-color",
    "core:window:allow-set-badge-count",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-ask",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "$HOME/.config/fusion-cli/**"
        },
        {
          "path": "$CONFIG/fusion-cli/**"
        }
      ]
    },
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify"
  ]
}
