{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fusion",
  "version": "0.7.18",
  "identifier": "com.fusion.desktop",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQwQjJCREE2Q0IyODQ3NTEKUldSUlJ5akxwcjJ5ME1sL2xSNEtQdnJITWFxOCs3a0R3NlUxclF5OWlFczU4c3BpdWwvNmR5VmMK",
      "endpoints": [
        "https://github.com/emirhhan/fusion-cli/releases/latest/download/latest.json"
      ]
    }
  },
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Fusion",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#111111",
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data: blob: https:",
        "media-src": "'self' asset: http://asset.localhost data: blob:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "frame-src": "'self' blob: data: fusion-preview: http://fusion-preview.localhost http://localhost:* http://127.0.0.1:* http://[::1]:* https://localhost:* https://127.0.0.1:* https://[::1]:*",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$HOME/.local/share/fusion-cli/gallery/**",
            "$HOME/.local/share/fusion-cli/library/yuklenenler/**",
            "$HOME/.config/fusion-cli/accounts/*/avatar.*",
            "$HOME/remote/uploads/**",
            "$LOCALDATA/fusion-cli/gallery/**"
          ],
          "deny": [
            "$HOME/.ssh/**",
            "$HOME/.gnupg/**",
            "$HOME/.aws/**",
            "$HOME/.azure/**",
            "$HOME/.kube/**",
            "$HOME/.docker/**",
            "$HOME/.config/gcloud/**",
            "$HOME/.netrc",
            "$HOME/.npmrc",
            "$HOME/.pypirc",
            "$HOME/.git-credentials",
            "$HOME/.codex/**",
            "$HOME/.claude/**",
            "$HOME/Library/Keychains/**",
            "$HOME/Library/Cookies/**",
            "$HOME/Library/Application Support/Google/Chrome/**",
            "$HOME/Library/Application Support/Chromium/**",
            "$HOME/Library/Application Support/Firefox/**",
            "$HOME/.local/share/fusion-cli/vault/**",
            "$HOME/.local/share/fusion-cli/web_profiles/**",
            "$HOME/**/secrets.enc",
            "$HOME/**/.env",
            "$HOME/**/.env.*",
            "$HOME/**/*.pem",
            "$HOME/**/*.key",
            "$HOME/**/id_rsa*",
            "$HOME/**/id_ed25519*"
          ]
        }
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline' http://localhost:1420",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data: blob: https:",
        "media-src": "'self' asset: http://asset.localhost data: blob:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420",
        "frame-src": "'self' blob: data: fusion-preview: http://fusion-preview.localhost http://localhost:* http://127.0.0.1:* http://[::1]:* https://localhost:* https://127.0.0.1:* https://[::1]:*",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist"
    }
  }
}
