# Fusion-CLI API anahtarları. Bu dosyayı `.env` olarak kopyalayıp doldur.
# `.env` git'e GİRMEZ (.gitignore'da).

# NVIDIA NIM — ücretsiz geliştirici anahtarı: https://build.nvidia.com/
NVIDIA_NIM_API_KEY=
# Boş bırakılırsa NVIDIA'nın barındırdığı uç kullanılır.
NVIDIA_NIM_API_BASE=

# OpenRouter — ücretsiz katman: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# İkisinden biri yeterlidir. İkisi de tanımlıysa yedek zinciri farklı sağlayıcılara
# yayıldığı için tur tek bir sağlayıcının hız sınırına takılmaz.
