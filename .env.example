# Fusion-CLI API anahtarları — en az birini doldur.
# Bu dosyayı `.env` olarak kopyalayıp kullan.
# `.env` git'e GİRMEZ (.gitignore'da).

# NVIDIA NIM — ücretsiz geliştirici anahtarı: https://build.nvidia.com/
NVIDIA_NIM_API_KEY=
# Boş bırakılırsa NVIDIA'nın barındırdığı uç kullanılır.
NVIDIA_NIM_API_BASE=

# OpenRouter — ücretsiz katman: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# EN AZ BİRİ yeterlidir; hangisi olduğu fark etmez. İkisi de tanımlıysa yedek
# zinciri farklı sağlayıcılara yayılır ve tur tek bir sağlayıcının sınırına
# takılmaz — ama bir sağlayıcı tükenince yük ötekine biner. Kotayı ayırmak
# istersen `/provider` ile tek sağlayıcıya kilitlen.
#
# NOT: Normal kurulumda anahtarlar KULLANICI DİZİNİNDE tutulur
# (~/.config/fusion-cli/.env). Bu dosya yalnızca proje bazlı override içindir.

# Langfuse/OTel açıkça opt-in'dir. Bir toplayıcı çalışmıyorsa 0 bırak.
FUSION_TRACING=0
