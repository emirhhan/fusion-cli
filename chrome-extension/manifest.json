{
  "manifest_version": 3,
  "name": "Fusion Browser",
  "version": "0.2.0",
  "description": "Fusion'ı Chrome'a bağlar: izin verdiğiniz sitelerde sekmeleri okur ve yönetir.",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "storage",
    "scripting",
    "activeTab",
    "tabs",
    "nativeMessaging",
    "offscreen"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "Fusion Browser"
  }
}
