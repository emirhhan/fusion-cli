{
  "manifest_version": 3,
  "name": "Fusion Browser",
  "version": "0.3.4",
  "description": "Fusion'ı Chrome'a bağlar: yan panelde sohbet eder, izin verdiğiniz sitelerde sayfayı okur, kaydırır ve tıklar.",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "storage",
    "scripting",
    "activeTab",
    "tabs",
    "nativeMessaging",
    "offscreen"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "Fusion",
    "default_icon": {
      "32": "icons/fusion-32.png"
    }
  },
  "icons": {
    "32": "icons/fusion-32.png",
    "128": "icons/fusion-128.png"
  }
}
