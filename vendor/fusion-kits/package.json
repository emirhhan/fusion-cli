{
  "name": "fusion-kits",
  "version": "0.1.0",
  "description": "Fusion Kits — bağımsız uzman ajan ve belge çalışma alanı",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "dev": "concurrently -k \"node --env-file-if-exists=.env --import tsx --watch scripts/kits-dev-server.mjs\" \"vite\"",
    "build": "node scripts/kits-dark-theme.mjs && vite build && tsc -p tsconfig.server.json",
    "start": "node --env-file-if-exists=.env dist/server/server/index.js",
    "browser": "node --env-file-if-exists=.env --import tsx src/browser/index.ts",
    "browser:start": "node --env-file-if-exists=.env dist/server/browser/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts vite.config.ts",
    "format": "prettier --write src tests scripts *.json *.ts *.js index.html public .github Dockerfile \"compose*.yml\" deployment README.md docs .env.example handoff/*.md --ignore-unknown",
    "check-format": "prettier --check src tests scripts *.json *.ts *.js index.html public .github Dockerfile \"compose*.yml\" deployment README.md docs .env.example handoff/*.md --ignore-unknown",
    "kits:start": "npx --yes --package=node@24.21.0 -- node scripts/kits-start.mjs",
    "kits:dev": "npx --yes --package=node@24.21.0 -- node scripts/kits-start.mjs --dev",
    "kits:check": "npx --yes --package=node@24.21.0 -- node scripts/kits-check.mjs",
    "kits:package": "npx --yes --package=node@24.21.0 -- node scripts/kits-package.mjs",
    "kits:visual": "npx --yes --package=node@24.21.0 -- node --import tsx scripts/kits-visual.mjs",
    "kits:fusion-smoke": "npx --yes --package=node@24.21.0 -- node --import tsx scripts/kits-fusion-smoke.mjs",
    "kits:theme": "npx --yes --package=node@24.21.0 -- node scripts/kits-dark-theme.mjs",
    "kits:bundle": "npx --yes --package=node@24.21.0 -- node scripts/kits-bundle.mjs",
    "kits:install": "npx --yes --package=node@24.21.0 -- node scripts/kits-install.mjs",
    "kits:local-chat-smoke": "npx --yes --package=node@24.21.0 -- node scripts/kits-local-chat-smoke.mjs",
    "kits:doctor": "npx --yes --package=node@24.21.0 -- node scripts/kits-doctor.mjs",
    "kits:reference": "npx --yes --package=node@24.21.0 -- node --import tsx scripts/kits-reference.mjs",
    "kits:web-smoke": "npx --yes --package=node@24.21.0 -- node --import tsx scripts/kits-public-web-smoke.mjs",
    "kits:ui-accept": "npx --yes --package=node@24.21.0 -- node --import tsx scripts/kits-ui-accept.mjs",
    "kits:browser-smoke": "npx --yes --package=node@24.21.0 -- node --import tsx scripts/kits-browser-smoke.mjs",
    "kits:model-smoke": "npx --yes --package=node@24.21.0 -- node scripts/kits-model-smoke.mjs",
    "kits:fusion-model-smoke": "npx --yes --package=node@24.21.0 -- node --import tsx scripts/kits-fusion-model-smoke.mjs"
  },
  "keywords": [],
  "author": "Atai Barkai",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@ag-ui/client": "^0.0.59",
    "@ag-ui/core": "^0.0.59",
    "@copilotkit/channels": "^0.11.0",
    "@copilotkit/core": "^1.75.0",
    "@copilotkit/react-core": "^1.75.0",
    "@copilotkit/runtime": "^1.75.0",
    "@hono/node-server": "^2.1.3",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@tanstack/ai": "^0.63.0",
    "@tanstack/ai-openai": "^0.25.1",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-placeholder": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/extension-task-item": "3.31.3",
    "@tiptap/extension-task-list": "3.31.3",
    "@tiptap/markdown": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@tiptap/suggestion": "3.31.3",
    "hono": "^4.13.11",
    "lucide-react": "^1.48.0",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rxjs": "^7.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fflate": "^0.8.3",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  },
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CopilotKit/OpenDots.git"
  },
  "overrides": {
    "undici": "^6.29.0"
  }
}
