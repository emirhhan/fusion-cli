    {
      "case_id": "raw-payload-byte-preservation",
      "provider": "synthetic",
      "transport": "synthetic",
      "split": "diagnostic",
      "provenance": "synthetic",
      "output": "FUSION_PAYLOAD id=\"body\"\nsatır 1\n\"alıntı\" \\ yol\nson satır\n\nFUSION_PAYLOAD_END\nFUSION_TOOL_CALL\n{\"name\": \"write_file\", \"arguments\": {\"path\": \"out.txt\", \"content\": {\"$ref\": \"body\"}}}\nFUSION_TOOL_CALL_END",
      "expected_calls": [
        {
          "name": "write_file",
          "arguments": {
            "path": "out.txt",
            "content": "satır 1\n\"alıntı\" \\ yol\nson satır\n"
          }
        }
      ]
    },
